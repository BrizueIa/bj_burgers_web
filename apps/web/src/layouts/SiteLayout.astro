---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const { title, description, currentPath = '/' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL || 'http://localhost:4100/api/v1';
const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'B&J Burgers',
  telephone: '+52 833 351 4381',
  servesCuisine: ['Hamburguesas', 'Hot dogs'],
  priceRange: '$$',
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '18:00', closes: '23:55' },
  ],
  areaServed: 'Canarios, Altamira, Tamaulipas',
  menu: new URL('/menu', Astro.site).toString(),
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070907" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(restaurantSchema)} />
    <title>{title}</title>
  </head>
  <body data-api-base={apiBaseUrl}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header currentPath={currentPath} />
    <main id="contenido"><slot /></main>
    <Footer />
    <script>
      type StoreStatus = {
        open: boolean;
        message: string;
        schedule: Array<{ dayOfWeek: number; opens: string; closes: string }>;
      };

      const apiBase = document.body.dataset.apiBase;
      const dayNames = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
      const formatTime = (value: string) => {
        const [hour, minute] = value.split(':').map(Number);
        const normalizedHour = hour % 12 || 12;
        return `${normalizedHour}:${String(minute).padStart(2, '0')} ${hour >= 12 ? 'pm' : 'am'}`;
      };
      const describeDays = (schedule: StoreStatus['schedule']) => {
        const days = schedule.map((slot) => slot.dayOfWeek);
        if (days.join(',') === '4,5,6,0') return 'Jueves a domingo';
        return days.map((day) => dayNames[day]).join(', ');
      };

      if (apiBase) {
        fetch(`${apiBase}/store-status`, { cache: 'no-store' })
          .then((response) => (response.ok ? response.json() : Promise.reject(response)))
          .then((value: StoreStatus) => {
            const schedule = value.schedule;
            if (!schedule.length) return;
            const days = describeDays(schedule);
            const hours = `${formatTime(schedule[0].opens)} — ${formatTime(schedule[0].closes)}`;
            document.querySelectorAll<HTMLElement>('[data-business-days]').forEach((element) => {
              element.textContent = days;
            });
            document.querySelectorAll<HTMLElement>('[data-business-hours]').forEach((element) => {
              element.textContent = hours;
            });
            document.querySelectorAll<HTMLElement>('[data-store-status]').forEach((element) => {
              element.classList.toggle('open', value.open);
              const label = element.querySelector('b');
              if (label) label.textContent = value.message;
            });
          })
          .catch(() => {});
      }
    </script>
  </body>
</html>
